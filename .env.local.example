# ============================================================
# Riverz Dealers: use a separate Supabase project and application URL.
NEXT_PUBLIC_RIVERZ_VERTICAL=dealers
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Supabase — requerido para arrancar.
# ============================================================

# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role: omite RLS. Sólo en server-side (webhooks, crons,
# motor de automatizaciones). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Meta / WhatsApp — requerido para WhatsApp, Messenger, Instagram.
# ============================================================

# Verifica HMAC-SHA256 de cada webhook entrante. Sin esto el
# endpoint rechaza todo.
META_APP_SECRET=your-meta-app-secret

# App ID público para el SDK de Embedded Signup.
META_APP_ID=your-meta-app-id
NEXT_PUBLIC_META_APP_ID=your-meta-app-id

# Configuration ID del flujo Embedded Signup.
NEXT_PUBLIC_META_ES_CONFIG_ID=your-config-id

# Token compartido del handshake GET de verificación del webhook.
META_WEBHOOK_VERIFY_TOKEN=your-verify-token

# AES-256-GCM para tokens guardados en BD (64 hex = 32 bytes).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotar invalida tokens existentes — los usuarios deben reconectar.
ENCRYPTION_KEY=your-64-char-hex-key-here

# ============================================================
# Google / Microsoft — OAuth para Gmail y Outlook.
# ============================================================

# Gmail OAuth (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Outlook OAuth (Azure Portal → App registrations).
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Zoho Mail OAuth (Zoho API Console → Server-based application).
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# ZOHO_MAIL_API_URL=https://mail.zoho.com

# Mercado Libre OAuth (DevCenter de Mercado Libre, de cualquier país). Debe
# ser la aplicación de Riverz: su nombre y logo son los que ve cada comercio
# al autorizar. Sólo permisos de Mercado Libre: Mercado Pago va aparte.
MERCADOLIBRE_CLIENT_ID=your-mercadolibre-app-id
MERCADOLIBRE_CLIENT_SECRET=your-mercadolibre-client-secret
# Aplicación anterior: sólo renueva las conexiones que autorizó.
# MERCADOLIBRE_LEGACY_CLIENT_ID=
# MERCADOLIBRE_LEGACY_CLIENT_SECRET=
# Secreto del callback de avisos: …/api/channels/mercadolibre/webhook?secret=…
# MERCADOLIBRE_WEBHOOK_SECRET=long-random-string

# Mercado Pago OAuth: aplicación propia (Mercado Pago Developers). Sin ella,
# el comercio conecta pegando su Access Token.
# MERCADOPAGO_CLIENT_ID=
# MERCADOPAGO_CLIENT_SECRET=

# Gmail push notifications (Pub/Sub). Opcional — si no se configura,
# se cae al polling cada 2-5 minutos.
# GMAIL_PUSH_TOPIC=projects/your-project/topics/gmail-push
# GMAIL_PUSH_SECRET=long-random-string

# Outlook push notifications. clientState verificado en cada POST.
# OUTLOOK_PUSH_CLIENT_STATE=long-random-string

# ============================================================
# Shopify — requerido si se conectan tiendas.
# ============================================================

SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_OAUTH_REDIRECT_URI=https://your-host/api/shopify/callback
SHOPIFY_API_VERSION=2025-10
SHOPIFY_SCOPES=read_orders,read_checkouts,read_customers,read_products
# true cuando Shopify apruebe la app en el App Store: muestra "Conectar" por OAuth.
SHOPIFY_APP_STORE_APPROVED=false

# ============================================================
# Crons — secretos compartidos para /api/*/cron.
# ============================================================

# Cubre /api/automations/cron, /api/cron/flows-resume,
# /api/flows/cron (barrido), /api/cron/gmail-poll,
# /api/cron/gmail-watch, /api/cron/outlook-poll,
# /api/cron/outlook-watch, /api/cron/meta-dm-backfill,
# /api/cron/meta-contact-names.
# Generar: openssl rand -hex 32
AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Cron de envío de broadcasts programados.
BROADCAST_CRON_SECRET=generate-a-long-random-string

# Cron de reintentos de pasos fallidos en flows.
FLOWS_RETRY_CRON_SECRET=generate-a-long-random-string

# Secreto para POST /api/meta/ads-sync (sincronización Meta Ads).
ADS_SYNC_SECRET=generate-a-long-random-string

# ============================================================
# Anthropic — requerido para asistencia IA (plantillas, flows,
# agente conversacional, búsqueda de productos).
# ============================================================

ANTHROPIC_API_KEY=sk-ant-your-key

# TypeSafe (Jev) — opcional. Decide sin escribir: si una conversación
# necesita una persona, qué intención tiene una respuesta, si un
# comentario es spam o quiere comprar. Veinte veces más barato que Haiku
# por decisión; sin la llave, esas decisiones vuelven a Anthropic.
# También se puede cargar desde /admin/claves sin redeploy.
TYPESAFE_API_KEY=

# ============================================================
# Observabilidad / opcional.
# ============================================================

# Sentry DSN. Si no se define, el logger sólo emite a stdout.
# SENTRY_DSN=https://...@sentry.io/...

# Upstash Redis — necesario para que el rate limit funcione en
# despliegues multi-réplica (Render escalado horizontal, edge).
# Sin estas variables el limitador cae a un Map en memoria por proceso
# y cada réplica tendrá su propio cupo (burst sobre el límite global).
# Crea una base gratis en https://upstash.com → Redis → Create Database
# y copia las dos credenciales "REST API".
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Hops de proxy confiables para derivar la IP del cliente desde
# X-Forwarded-For (rate-limit per-IP). Default 1 = un único proxy frontal
# (Render). Subir solo si hay otro proxy/CDN delante (p.ej. Cloudflare).
# TRUSTED_PROXY_HOPS=1

# Firecrawl — requerida para generar/actualizar el conocimiento del
# agente IA scrapeando la web de la marca. Sin esta var el scrape
# responde 500. Crear key en https://firecrawl.dev.
# FIRECRAWL_API_KEY=fc-your-key

# ============================================================
# Misc.
# ============================================================

# Las URLs de Dealers se configuran al inicio de este archivo.
# En producción: https://riverz-dealers.onrender.com (o su dominio propio).

# Latitude - server-side AI tracing (optional). No keys in NEXT_PUBLIC_* variables.
LATITUDE_API_KEY=
LATITUDE_PROJECT_SLUG=riverz-dealers
# Set false to disable exports without changing AI behavior.
LATITUDE_TRACING_ENABLED=false
