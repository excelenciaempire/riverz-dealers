# --- LiveKit Cloud ---
LIVEKIT_URL=wss://<tu-proyecto>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Proveedores del pipeline STT -> LLM -> TTS ---
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Fish Audio (TTS S2.1) — sólo si /admin/voz elige ese proveedor.
FISH_API_KEY=

# --- Backend Riverz (Next.js) ---
# Base URL del web app; el worker consume /api/internal/voice/*
RIVERZ_BASE_URL=https://app.riverz.co
# Secreto compartido -> se envía como `Authorization: Bearer ${VOICE_WORKER_SECRET}`
VOICE_WORKER_SECRET=

# --- Grabación (LiveKit Egress -> bucket S3-compatible; p.ej. Supabase Storage) ---
# Todas OPCIONALES: si faltan y recording.enabled=true, se loguea warning y NO se graba.
RECORDING_S3_BUCKET=
# Endpoint S3-compatible (Supabase: https://<proj>.supabase.co/storage/v1/s3). Vacío = AWS S3.
RECORDING_S3_ENDPOINT=
RECORDING_S3_REGION=auto
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET_KEY=

# NOTA proveedores OpenAI-compatible / Modal:
# STT/LLM/TTS/realtime NO usan env aparte: sus base_url + api_key llegan por request
# en GET /api/internal/voice/context (campos stt/llm/voice/realtime). El admin apunta
# esas capas a un endpoint en Modal (vLLM / Nano-vLLM / PersonaPlex).
# ANTHROPIC/DEEPGRAM/ELEVENLABS de arriba se usan sólo cuando el cfg NO trae base_url.
